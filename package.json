{
  "name": "@amoeba/libac",
  "description": "Library for working with Asheron's Call data structures and protocols.",
  "author": "Bryce Mecum",
  "version": "0.2.3",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amoeba/libac-js.git"
  },
  "bugs": {
    "url": "https://github.com/amoeba/libac-js/issues"
  },
  "homepage": "https://github.com/amoeba/libac-js#readme",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.browser.json && tsc -p tsconfig.node.json",
    "typecheck:browser": "tsc -p tsconfig.browser.json --noEmit",
    "check:browser": "node scripts/check-browser-bundle.mjs",
    "verify": "npm run build && npm run check:browser && npm run typecheck:browser && npm test",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
